# Copy to .env (never commit .env). Every value can also be set in the host's "Environment / Secrets" settings.

# ---------- app ----------
APP_ENV=production
PUBLIC_URL=https://audit.homebuildermarketers.com   # the address people open; used for Google sign-in and secure cookies
SECRET_KEY=                                         # long random string: python3 -c "import secrets; print(secrets.token_hex(32))"
HBM_DATA_DIR=/data                                  # persistent disk: database, audits, PDFs
TRUSTED_PROXY=*                                     # the host's HTTPS proxy sits in front (Render, Railway, Caddy)

# ---------- who can sign in ----------
ALLOWED_EMAIL_DOMAIN=homebuildermarketers.com
ADMIN_EMAILS=lav@homebuildermarketers.com           # created as Admin on first start, so they can sign in with an emailed code
# Email + password and one-time email codes are always on. Codes need an email account to send from:
SMTP_HOST=smtp.gmail.com                            # Google Workspace: smtp.gmail.com (or smtp-relay.gmail.com); others: their SMTP host
SMTP_PORT=587                                       # 587 (STARTTLS) or 465 (SSL)
SMTP_USER=no-reply@homebuildermarketers.com
SMTP_PASSWORD=                                      # an app password for that mailbox, not its normal password
MAIL_FROM=no-reply@homebuildermarketers.com
# Optional extra: "Sign in with Google"
GOOGLE_CLIENT_ID=                                   # Google Cloud > APIs & Services > Credentials > OAuth client (Web)
GOOGLE_CLIENT_SECRET=

# ---------- data providers (enter your own; never paste them in chat or commit them) ----------
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SEMRUSH_API_KEY=
DATAWISE_TOKEN=

# ---------- optional tuning ----------
AUDIT_WORKERS=3            # audits run at the same time
DAILY_AUDITS_PER_USER=100
HBM_MAX_LOCATIONS=5        # main market + up to 4 more cities per audit
SESSION_DAYS=7
